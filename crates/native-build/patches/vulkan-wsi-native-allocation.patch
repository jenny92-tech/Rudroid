+// INPUT: Instance extension selection, downstream Vulkan entrypoints and owned local surfaces.
+// OUTPUT: Explicit headless carrier opt-in with ordinary Wayland registration and failure cleanup.
+// POS: Rudroid compatibility policy; no fabricated handles or alternate presentation implementation.
+// Copyright 2026 jenny92-tech and the Rudroid contributors.
+// SPDX-License-Identifier: LicenseRef-Rudroid-NC-SourceShare-1.0
+#pragma once
+
+#include "layer/private_data.hpp"
+#include "util/extension_list.hpp"
+#include "util/log.hpp"
+#include <cstdlib>
+#include <cstring>
+
+namespace wsi
+{
+namespace wayland
+{
+
+inline bool headless_surface_carrier_requested()
+{
+   const char *value = std::getenv("RUDROID_WSI_HEADLESS_SURFACE");
+   return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+/* Read the opt-in during instance creation, not again during surface creation.
+ * The layer owns Wayland queries/presentation; headless is only a real lower
+ * surface handle. Do not enable the lower extension for unrelated platforms. */
+inline VkResult enable_headless_surface_carrier(util::extension_list &extensions, bool requested, bool &enabled)
+{
+   enabled = false;
+   if (!requested || !extensions.contains(VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME))
+   {
+      return VK_SUCCESS;
+   }
+   if (!extensions.contains(VK_KHR_SURFACE_EXTENSION_NAME))
+   {
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+   }
+   if (!extensions.contains(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME))
+   {
+      VkResult result = extensions.add(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME);
+      if (result != VK_SUCCESS)
+      {
+         return result;
+      }
+   }
+   enabled = true;
+   return VK_SUCCESS;
+}
+
+/* Shared by production and the CPU fixture. make_surface returns an owner;
+ * register_surface transfers it only on success, using the existing instance
+ * map. A private candidate keeps the public output null on every failure. */
+template <typename MakeSurface, typename RegisterSurface>
+VkResult create_wayland_surface_carrier(const layer::dispatch_table &dispatch, bool opted_in, bool headless_enabled,
+                                       VkInstance instance, const VkWaylandSurfaceCreateInfoKHR *info,
+                                       const VkAllocationCallbacks *allocator, VkSurfaceKHR *out,
+                                       MakeSurface make_surface, RegisterSurface register_surface)
+{
+   *out = VK_NULL_HANDLE;
+   auto wayland = dispatch.get_fn<PFN_vkCreateWaylandSurfaceKHR>("vkCreateWaylandSurfaceKHR");
+   auto headless = dispatch.get_fn<PFN_vkCreateHeadlessSurfaceEXT>("vkCreateHeadlessSurfaceEXT");
+   auto destroy = dispatch.get_fn<PFN_vkDestroySurfaceKHR>("vkDestroySurfaceKHR");
+   if (!destroy.has_value() ||
+       (!wayland.has_value() && !(opted_in && headless_enabled && headless.has_value())))
+   {
+      WSI_LOG_ERROR("Downstream Wayland surface unavailable; headless carrier requires explicit opt-in and enabled entrypoints");
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+   }
+   if (!wayland.has_value() && (info->pNext != nullptr || info->flags != 0))
+   {
+      /* No pNext structures extend either create-info in the pinned registry.
+       * Never forward a Wayland chain to another structure or silently drop it. */
+      WSI_LOG_ERROR("Headless carrier cannot honor Wayland surface flags or pNext");
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   auto local = make_surface();
+   if (!local)
+   {
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   VkSurfaceKHR candidate = VK_NULL_HANDLE;
+   VkResult result;
+   if (wayland.has_value())
+   {
+      result = (*wayland)(instance, info, allocator, &candidate);
+   }
+   else
+   {
+      const VkHeadlessSurfaceCreateInfoEXT headless_info{
+         VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT, nullptr, 0
+      };
+      result = (*headless)(instance, &headless_info, allocator, &candidate);
+   }
+   if (result != VK_SUCCESS)
+   {
+      return result;
+   }
+   if (candidate == VK_NULL_HANDLE)
+   {
+      WSI_LOG_ERROR("Downstream surface creation succeeded without a handle");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   result = register_surface(candidate, local);
+   if (result != VK_SUCCESS)
+   {
+      (*destroy)(instance, candidate, allocator);
+      return result;
+   }
+   *out = candidate;
+   return VK_SUCCESS;
+}
+
